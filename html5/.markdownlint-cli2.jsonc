{
  "config": {
    "default": true,
    "MD013": { "line_length": 90, "code_blocks": false, "tables": false },
    "MD033": false,
    "MD041": false
  },
  "globs": ["../README.md", "../doc/**/*.md", "**/*.md"],
  "ignores": ["**/node_modules/**", "**/test-results/**", "**/playwright-report/**"]
}
